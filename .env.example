# ==========================================
# AI Telecaller Configuration
# ==========================================

# Public hostname (ngrok without https://, e.g. abc123.ngrok-free.app)
PUBLIC_HOSTNAME=your-ngrok-subdomain.ngrok-free.app
PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# 1. Twilio Credentials (Required for phone calls)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# TTS Configuration (choose "cartesia" for ultra-fast telephony or "sarvam")
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_VOICE_ID=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
CARTESIA_MODEL=sonic-3.6

# 2. Sarvam AI (Required for Marathi STT & optional fallback TTS)
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_TTS_SPEAKER=ritu
SARVAM_TTS_LANGUAGE_CODE=mr-IN
SARVAM_STT_LANGUAGE_CODE=mr-IN

# 3. LLM Brain (Choose ONE provider: "gemini", "together", "groq", or "openai")
LLM_PROVIDER=gemini

# If using Gemini (Recommended):
GEMINI_API_KEY=your_gemini_api_key

# If using Together AI (Optional - used as fallback):
TOGETHER_API_KEY=

# If using Groq (Optional - used as fallback):
GROQ_API_KEY=

# If using OpenAI (Optional - used as fallback):
OPENAI_API_KEY=

# Voice Activity Detection (VAD) Tuning
SILENCE_RMS_THRESHOLD=230
SILENCE_DURATION_MS=550

# Production Settings
MAX_CALL_DURATION_SECONDS=300
MAX_CONCURRENT_CALLS=50
CALLING_HOURS_START=9
CALLING_HOURS_END=21
ENFORCE_CALLING_HOURS=true
RATE_LIMIT_CALLS_PER_MINUTE=30
API_RETRY_ATTEMPTS=3
